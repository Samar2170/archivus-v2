# Stage 1: Build the SvelteKit app
FROM node:22-alpine AS builder

WORKDIR /app

COPY archivus-svelte/package*.json ./
RUN npm ci

COPY archivus-svelte/ .

# PUBLIC_API_URL is baked in at build time for browser-side calls
ARG PUBLIC_API_URL=http://localhost:8000
ENV PUBLIC_API_URL=$PUBLIC_API_URL

RUN npm run build

# Stage 2: Minimal runtime
FROM node:22-alpine

WORKDIR /app

COPY --from=builder /app/build ./build
COPY --from=builder /app/package*.json ./
RUN npm ci --omit=dev

ENV PORT=3000
ENV HOST=0.0.0.0

EXPOSE 3000

CMD ["node", "build"]
